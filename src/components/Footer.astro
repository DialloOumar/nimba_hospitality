---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../config';
import { DESTINATIONS } from '../data/destinations';
import { url } from '../lib/url';

const featured = DESTINATIONS.filter((d) => d.featured).slice(0, 6);
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, v]) => v);
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer-top">
      <a href={url('/')} class="footer-logo" aria-label={SITE.name}>
        <Logo tagline />
      </a>
      <p class="footer-pitch">
        Un groupe hôtelier guinéen, ancré à Conakry, qui conçoit, gère et fait vivre des lieux d'accueil à la hauteur de la
        destination Guinée.
      </p>
    </div>

    <div class="footer-grid">
      <div>
        <h2 class="footer-title">Navigation</h2>
        <ul>
          <li><a href={url('/')}>Accueil</a></li>
          {NAV.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-title">Destinations</h2>
        <ul>
          {featured.map((d) => <li><a href={url(`/destinations/${d.slug}`)}>{d.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-title">Contact</h2>
        <ul class="footer-contact">
          <li>
            <Icon name="mail" />
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          {
            SITE.phone && (
              <li>
                <Icon name="phone" />
                <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
              </li>
            )
          }
          <li>
            <Icon name="pin" />
            <span>{SITE.address.map((l) => <>{l}<br /></>)}</span>
          </li>
        </ul>
        {
          socials.length > 0 && (
            <ul class="footer-social">
              {socials.map(([k, v]) => (
                <li>
                  <a href={v} target="_blank" rel="noopener">
                    {k}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}. Tous droits réservés.</span>
      <span class="footer-links">
        <a href={url('/credits')}>Crédits photographiques</a>
        <span aria-hidden="true">·</span>
        <span>Conakry, Guinée</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --logo-a: var(--white);
    background: var(--green-950);
    padding: clamp(72px, 9vw, 120px) 0 32px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }
  .footer-top {
    display: grid;
    gap: 32px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-logo {
    display: block;
    height: clamp(64px, 9vw, 92px);
  }
  .footer-pitch {
    max-width: 440px;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
  }
  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .footer-grid {
    display: grid;
    gap: 40px;
    padding: 56px 0;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .footer-title {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    transition: color 0.3s;
  }
  a:hover {
    color: var(--gold-300);
  }
  .footer-contact li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .footer-contact :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 4px;
    color: var(--gold);
  }
  .footer-social {
    margin-top: 20px;
    display: flex;
    gap: 18px;
    text-transform: capitalize;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-links {
    display: flex;
    gap: 10px;
  }
</style>
