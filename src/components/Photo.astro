---
// Responsive photo with optional scroll parallax and optional "wipe" reveal.
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';

interface Props {
  k: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  imgClass?: string;
  /** Parallax strength (0.05–0.15). The .media frame clips the overflow. */
  parallax?: number;
  /** Wipe the image into view when scrolled to. */
  wipe?: boolean;
}

const {
  k,
  alt,
  sizes = '100vw',
  widths = [480, 800, 1200, 1600, 2200],
  eager = false,
  class: cls = '',
  imgClass = '',
  parallax,
  wipe = false,
} = Astro.props;

const img = photo(k);
const MAX = 2400;
const usable = widths.filter((w) => w <= img.width && w <= MAX);
const top = Math.min(img.width, MAX);
if (!usable.includes(top) && top > (usable.at(-1) ?? 0)) usable.push(top);
// Size of the <img> fallback (browsers without srcset/webp support) — keep it reasonable.
const fallbackWidth = Math.min(img.width, 1600);
---

<div class:list={['media', cls]} data-reveal-img={wipe ? '' : undefined}>
  <div class:list={['media-layer', { 'media-layer--parallax': parallax }]} data-parallax={parallax}>
    <Picture
      src={img}
      alt={alt}
      widths={usable}
      width={fallbackWidth}
      sizes={sizes}
      formats={['webp']}
      fallbackFormat="jpg"
      quality={74}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class={imgClass}
    />
  </div>
  <slot />
</div>
