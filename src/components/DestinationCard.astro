---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { regionById, type Destination } from '../data/destinations';
import { url } from '../lib/url';

interface Props {
  d: Destination;
  ratio?: string;
  sizes?: string;
  showRegion?: boolean;
}
const { d, ratio = '4 / 5', sizes = '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw', showRegion = true } =
  Astro.props;
const region = regionById(d.region);
---

<a href={url(`/destinations/${d.slug}`)} class="dcard" data-region={d.region}>
  <Photo k={d.photo} alt={d.name} sizes={sizes} widths={[400, 640, 900, 1200]} class="dcard-media media--zoom" credit={false} />
  <div class="dcard-shade" aria-hidden="true"></div>
  <div class="dcard-body">
    {showRegion && <span class="dcard-region">{region.name}</span>}
    <h3 class="dcard-title">{d.name}</h3>
    <p class="dcard-text">{d.excerpt}</p>
    <span class="dcard-more">Découvrir <Icon name="arrow" /></span>
  </div>
</a>

<style define:vars={{ ratio }}>
  .dcard {
    position: relative;
    display: block;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    color: var(--white);
    isolation: isolate;
  }
  .dcard :global(.dcard-media) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .dcard-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(7, 31, 20, 0.92) 0%, rgba(7, 31, 20, 0.35) 48%, rgba(7, 31, 20, 0.05) 75%);
    transition: background 0.6s var(--ease);
  }
  .dcard-body {
    position: absolute;
    inset: auto 0 0;
    padding: clamp(22px, 2.6vw, 34px);
  }
  .dcard-region {
    display: inline-block;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin-bottom: 10px;
  }
  .dcard-title {
    color: var(--white);
    font-size: clamp(1.7rem, 2.4vw, 2.2rem);
    line-height: 1.05;
  }
  .dcard-text {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 10px 0 0;
    max-width: 34ch;
  }
  .dcard-more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-300);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }
  .dcard-more :global(svg) {
    width: 16px;
    height: 16px;
  }
  .dcard:hover .dcard-more,
  .dcard:focus-visible .dcard-more {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .dcard-more {
      opacity: 1;
      transform: none;
    }
  }
</style>
