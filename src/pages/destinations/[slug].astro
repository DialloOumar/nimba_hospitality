---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DESTINATIONS, regionById, type Destination } from '../../data/destinations';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  DESTINATIONS.map((d, i) => ({
    params: { slug: d.slug },
    props: {
      d,
      prev: DESTINATIONS[(i - 1 + DESTINATIONS.length) % DESTINATIONS.length],
      next: DESTINATIONS[(i + 1) % DESTINATIONS.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  d: Destination;
  prev: Destination;
  next: Destination;
}
const { d, prev, next } = Astro.props;
const region = regionById(d.region);
const related = DESTINATIONS.filter((x) => x.region === d.region && x.slug !== d.slug).slice(0, 3);
const others = related.length >= 2 ? related : DESTINATIONS.filter((x) => x.slug !== d.slug && x.featured).slice(0, 3);

const facts = [
  { icon: 'pin', label: 'Localisation', value: d.info.location },
  { icon: 'compass', label: 'Depuis Conakry', value: d.info.fromConakry },
  { icon: 'sun', label: 'Meilleure période', value: d.info.season },
  { icon: 'star', label: 'Idéal pour', value: d.info.idealFor },
] as const;
---

<Base title={`${d.name} — ${region.name}`} description={d.lead} ogPhoto={d.photo}>
  <section class="dhero on-dark">
    <Photo k={d.photo} alt={`${d.name}, ${region.name}`} eager class="dhero-media" />
    <div class="dhero-shade" aria-hidden="true"></div>
    <div class="container dhero-content">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={url('/')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('/destinations')}>Destinations</a>
        <span aria-hidden="true">/</span>
        <a href={url(`/destinations#${d.region}`)}>{region.name}</a>
      </nav>
      <span class="eyebrow">{d.kicker}</span>
      <h1 class="display dhero-title">{d.name}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="dbody">
        <article class="dmain">
          <p class="lead" data-reveal>{d.lead}</p>
          {d.body.map((p, i) => <p data-reveal style={`--delay:${0.06 * (i + 1)}s`}>{p}</p>)}

          <h2 class="h3 dsub" data-reveal>À ne pas manquer</h2>
          <ul class="highlights" data-reveal>
            {
              d.highlights.map((h) => (
                <li>
                  <Icon name="plus" />
                  {h}
                </li>
              ))
            }
          </ul>
        </article>

        <aside class="dside" data-reveal style="--delay:.1s">
          <div class="facts">
            <span class="facts-title">Infos pratiques</span>
            <dl>
              {
                facts.map((f) => (
                  <div class="fact">
                    <dt>
                      <Icon name={f.icon} /> {f.label}
                    </dt>
                    <dd>{f.value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="facts-note">
              Informations indicatives : les conditions d'accès varient selon la saison. Renseignez-vous localement avant
              votre départ.
            </p>
          </div>
          <div class="region-box">
            <span class="facts-title">{region.name}</span>
            <p>{region.description}</p>
            <a href={url(`/destinations#${d.region}`)} class="link-arrow">Explorer la région <Icon name="arrow" /></a>
          </div>
        </aside>
      </div>

      {
        d.gallery && d.gallery.length > 0 && (
          <div class:list={['gallery', `gallery--${d.gallery.length}`]}>
            {d.gallery.map((g, i) => (
              <div data-reveal style={`--delay:${i * 0.08}s`}>
                <Photo k={g} alt={`${d.name} — vue ${i + 2}`} sizes="(min-width: 900px) 50vw, 100vw" class="gallery-media" />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">{related.length >= 2 ? `Également en ${region.name}` : 'Poursuivre le voyage'}</span>
          <h2 class="h2">Prolonger <em>l'escapade.</em></h2>
        </div>
        <a href={url('/destinations')} class="link-arrow">Toutes les destinations <Icon name="arrow" /></a>
      </div>
      <div class="related">
        {others.map((o) => <DestinationCard d={o} ratio="4 / 4.4" />)}
      </div>

      <nav class="pager" aria-label="Destinations voisines">
        <a href={url(`/destinations/${prev.slug}`)} class="pager-link">
          <Icon name="arrow-left" />
          <span><small>Précédente</small>{prev.name}</span>
        </a>
        <a href={url(`/destinations/${next.slug}`)} class="pager-link pager-link--next">
          <span><small>Suivante</small>{next.name}</span>
          <Icon name="arrow" />
        </a>
      </nav>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .dhero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 48px) 0 clamp(48px, 7vw, 96px);
    overflow: hidden;
    background: var(--green-950);
  }
  .dhero :global(.dhero-media) {
    position: absolute;
    inset: 0;
  }
  .dhero :global(.dhero-media img) {
    animation: dzoom 14s var(--ease-out) both;
  }
  @keyframes dzoom {
    from {
      transform: scale(1.1);
    }
  }
  .dhero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 31, 20, 0.9), rgba(7, 31, 20, 0.15) 55%, rgba(7, 31, 20, 0.35));
  }
  .dhero-content {
    position: relative;
  }
  .dhero-title {
    color: var(--white);
    max-width: 14ch;
    font-size: clamp(3rem, 8vw, 7rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .crumbs a:hover {
    color: var(--gold-300);
  }

  .dbody {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
  }
  @media (min-width: 960px) {
    .dbody {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: start;
    }
    .dside {
      position: sticky;
      top: calc(72px + 32px);
    }
  }
  .dmain .lead {
    margin-bottom: 32px;
  }
  .dmain p:not(.lead) {
    font-size: 1.04rem;
    line-height: 1.85;
  }
  .dsub {
    margin: 56px 0 20px;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .highlights li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .highlights :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 4px;
    color: var(--gold-600);
  }

  .facts,
  .region-box {
    background: var(--white);
    border: 1px solid var(--line);
    padding: clamp(24px, 3vw, 36px);
  }
  .region-box {
    margin-top: 16px;
    background: var(--green-900);
    border-color: var(--green-900);
    color: rgba(255, 255, 255, 0.75);
  }
  .region-box p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.92rem;
    margin: 10px 0 22px;
  }
  .region-box .link-arrow {
    color: var(--white);
  }
  .facts-title {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin-bottom: 8px;
  }
  .region-box .facts-title {
    color: var(--gold-300);
  }
  .facts dl {
    margin: 0;
  }
  .fact {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact dt {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dt :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--gold-600);
  }
  .fact dd {
    margin: 6px 0 0 26px;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--green-900);
  }
  .facts-note {
    margin-top: 18px;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .gallery {
    display: grid;
    gap: clamp(14px, 1.6vw, 24px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .gallery--2 {
    grid-template-columns: 1fr 1fr;
  }
  .gallery :global(.gallery-media) {
    aspect-ratio: 3 / 2;
  }
  .gallery--1 :global(.gallery-media) {
    aspect-ratio: 21 / 9;
  }
  @media (max-width: 700px) {
    .gallery--1 :global(.gallery-media) {
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 700px) {
    .gallery--2 {
      grid-template-columns: 1fr;
    }
  }

  .related {
    display: grid;
    gap: clamp(14px, 1.6vw, 24px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 900px) {
    .related {
      grid-template-columns: 1fr;
    }
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--green-900);
    transition: color 0.3s;
  }
  .pager-link span {
    display: grid;
  }
  .pager-link small {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-600);
  }
  .pager-link--next {
    text-align: right;
  }
  .pager-link :global(svg) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--gold-600);
  }
  .pager-link:hover {
    color: var(--gold-600);
  }
</style>
