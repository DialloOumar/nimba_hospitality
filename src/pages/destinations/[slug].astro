---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DESTINATIONS, regionById, type Destination } from '../../data/destinations';
import { url } from '../../lib/url';
import { photo, credit } from '../../lib/photos';
import { getImage } from 'astro:assets';

export const getStaticPaths = (() =>
  DESTINATIONS.map((d, i) => ({
    params: { slug: d.slug },
    props: {
      d,
      prev: DESTINATIONS[(i - 1 + DESTINATIONS.length) % DESTINATIONS.length],
      next: DESTINATIONS[(i + 1) % DESTINATIONS.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  d: Destination;
  prev: Destination;
  next: Destination;
}
const { d, prev, next } = Astro.props;
const region = regionById(d.region);
const related = DESTINATIONS.filter((x) => x.region === d.region && x.slug !== d.slug).slice(0, 3);
const others = related.length >= 2 ? related : DESTINATIONS.filter((x) => x.slug !== d.slug && x.featured).slice(0, 3);

// Gallery + lightbox data (large WebP for the full-screen viewer).
const lightbox = await Promise.all(
  (d.gallery ?? []).map(async (key, i) => {
    const src = photo(key);
    const big = await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 80 });
    const c = credit(key);
    return { key, src: big.src, alt: `${d.name} — vue ${i + 2}`, credit: c ? `© ${c.artist}` : '' };
  }),
);

const facts = [
  { icon: 'pin', label: 'Localisation', value: d.info.location },
  { icon: 'compass', label: 'Depuis Conakry', value: d.info.fromConakry },
  { icon: 'sun', label: 'Meilleure période', value: d.info.season },
  { icon: 'star', label: 'Idéal pour', value: d.info.idealFor },
] as const;
---

<Base title={`${d.name} — ${region.name}`} description={d.lead} ogPhoto={d.photo}>
  <section class="dhero on-dark">
    <Photo k={d.photo} alt={`${d.name}, ${region.name}`} eager class="dhero-media" parallax={0.08} />
    <div class="dhero-shade" aria-hidden="true"></div>
    <div class="container dhero-content">
      <nav class="crumbs" aria-label="Fil d'Ariane">
        <a href={url('/')}>Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={url('/destinations')}>Destinations</a>
        <span aria-hidden="true">/</span>
        <a href={url(`/destinations#${d.region}`)}>{region.name}</a>
      </nav>
      <span class="eyebrow">{d.kicker}</span>
      <h1 class="display dhero-title">{d.name}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="dbody">
        <article class="dmain">
          <p class="lead" data-reveal>{d.lead}</p>
          {d.body.map((p, i) => <p data-reveal style={`--delay:${0.06 * (i + 1)}s`}>{p}</p>)}

          <h2 class="h3 dsub" data-reveal>À ne pas manquer</h2>
          <ul class="highlights" data-reveal>
            {
              d.highlights.map((h) => (
                <li>
                  <Icon name="plus" />
                  {h}
                </li>
              ))
            }
          </ul>
        </article>

        <aside class="dside" data-reveal style="--delay:.1s">
          <div class="facts">
            <span class="facts-title">Infos pratiques</span>
            <dl>
              {
                facts.map((f) => (
                  <div class="fact">
                    <dt>
                      <Icon name={f.icon} /> {f.label}
                    </dt>
                    <dd>{f.value}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="facts-note">
              Informations indicatives : les conditions d'accès varient selon la saison. Renseignez-vous localement avant
              votre départ.
            </p>
          </div>
          <div class="region-box">
            <span class="facts-title">{region.name}</span>
            <p>{region.description}</p>
            <a href={url(`/destinations#${d.region}`)} class="link-arrow">Explorer la région <Icon name="arrow" /></a>
          </div>
        </aside>
      </div>

      {
        lightbox.length > 0 && (
          <div class:list={['gallery', `gallery--${lightbox.length}`]}>
            {lightbox.map((item, i) => (
              <figure class="gallery-item" data-reveal style={`--delay:${i * 0.08}s`}>
                <button type="button" class="gallery-open" data-lb-open={i} aria-label={`Agrandir : ${item.alt}`}>
                  <Photo
                    k={item.key}
                    alt={item.alt}
                    sizes={lightbox.length === 3 ? '(min-width: 900px) 33vw, 100vw' : '(min-width: 900px) 50vw, 100vw'}
                    class="gallery-media media--zoom"
                    credit={false}
                    wipe
                  />
                  <span class="gallery-zoom" aria-hidden="true">
                    <Icon name="plus" />
                  </span>
                </button>
                {item.credit && <figcaption>{item.credit}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }

      {
        lightbox.length > 0 && (
          <dialog class="lightbox" data-lightbox aria-label="Galerie photos">
            <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Fermer">
              <Icon name="plus" />
            </button>
            {lightbox.length > 1 && (
              <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Photo précédente">
                <Icon name="arrow-left" />
              </button>
            )}
            <figure class="lb-figure">
              <img data-lb-img alt="" />
              <figcaption>
                <span data-lb-caption />
                <span class="lb-count" data-lb-count />
              </figcaption>
            </figure>
            {lightbox.length > 1 && (
              <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Photo suivante">
                <Icon name="arrow" />
              </button>
            )}
            <script is:inline type="application/json" data-lb-data set:html={JSON.stringify(lightbox)} />
          </dialog>
        )
      }
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">{related.length >= 2 ? `Également en ${region.name}` : 'Poursuivre le voyage'}</span>
          <h2 class="h2">Prolonger <em>l'escapade.</em></h2>
        </div>
        <a href={url('/destinations')} class="link-arrow">Toutes les destinations <Icon name="arrow" /></a>
      </div>
      <div class="related">
        {others.map((o) => <DestinationCard d={o} ratio="4 / 4.4" />)}
      </div>

      <nav class="pager" aria-label="Destinations voisines">
        <a href={url(`/destinations/${prev.slug}`)} class="pager-link">
          <Icon name="arrow-left" />
          <span><small>Précédente</small>{prev.name}</span>
        </a>
        <a href={url(`/destinations/${next.slug}`)} class="pager-link pager-link--next">
          <span><small>Suivante</small>{next.name}</span>
          <Icon name="arrow" />
        </a>
      </nav>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .dhero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 48px) 0 clamp(48px, 7vw, 96px);
    overflow: hidden;
    background: var(--green-950);
  }
  .dhero :global(.dhero-media) {
    position: absolute;
    inset: 0;
  }
  .dhero :global(.dhero-media img) {
    animation: dzoom 14s var(--ease-out) both;
  }
  @keyframes dzoom {
    from {
      transform: scale(1.1);
    }
  }
  .dhero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(7, 31, 20, 0.9), rgba(7, 31, 20, 0.15) 55%, rgba(7, 31, 20, 0.35));
  }
  .dhero-content {
    position: relative;
  }
  .dhero-title {
    color: var(--white);
    max-width: 14ch;
    font-size: clamp(3rem, 8vw, 7rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .crumbs a:hover {
    color: var(--gold-300);
  }

  .dbody {
    display: grid;
    gap: clamp(48px, 6vw, 96px);
  }
  @media (min-width: 960px) {
    .dbody {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: start;
    }
    .dside {
      position: sticky;
      top: calc(72px + 32px);
    }
  }
  .dmain .lead {
    margin-bottom: 32px;
  }
  .dmain p:not(.lead) {
    font-size: 1.04rem;
    line-height: 1.85;
  }
  .dsub {
    margin: 56px 0 20px;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .highlights li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .highlights :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 4px;
    color: var(--gold-600);
  }

  .facts,
  .region-box {
    background: var(--white);
    border: 1px solid var(--line);
    padding: clamp(24px, 3vw, 36px);
  }
  .region-box {
    margin-top: 16px;
    background: var(--green-900);
    border-color: var(--green-900);
    color: rgba(255, 255, 255, 0.75);
  }
  .region-box p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.92rem;
    margin: 10px 0 22px;
  }
  .region-box .link-arrow {
    color: var(--white);
  }
  .facts-title {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-600);
    margin-bottom: 8px;
  }
  .region-box .facts-title {
    color: var(--gold-300);
  }
  .facts dl {
    margin: 0;
  }
  .fact {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact dt {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dt :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--gold-600);
  }
  .fact dd {
    margin: 6px 0 0 26px;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--green-900);
  }
  .facts-note {
    margin-top: 18px;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .gallery {
    display: grid;
    gap: clamp(14px, 1.6vw, 24px);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .gallery--2 {
    grid-template-columns: 1fr 1fr;
  }
  .gallery--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item figcaption {
    margin-top: 10px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .gallery-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .gallery-zoom {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(250, 247, 241, 0.92);
    color: var(--green-900);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .gallery-zoom :global(svg) {
    width: 20px;
    height: 20px;
  }
  .gallery-open:hover .gallery-zoom,
  .gallery-open:focus-visible .gallery-zoom {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .gallery-zoom {
      opacity: 1;
      transform: none;
    }
  }
  .gallery :global(.gallery-media) {
    aspect-ratio: 3 / 2;
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(7, 31, 20, 0.96);
    color: var(--white);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    animation: lb-in 0.4s var(--ease-out);
  }
  .lightbox::backdrop {
    background: transparent;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-figure {
    grid-column: 2;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 64px 0 24px;
    min-width: 0;
  }
  .lb-figure img {
    max-width: 100%;
    max-height: calc(100dvh - 150px);
    object-fit: contain;
    animation: lb-img 0.5s var(--ease-out);
  }
  @keyframes lb-img {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  .lb-figure figcaption {
    display: flex;
    gap: 18px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .lb-count {
    font-family: var(--serif);
    color: var(--gold-300);
  }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 clamp(8px, 2vw, 28px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    transition:
      background 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  .lb-btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--green-950);
  }
  .lb-btn :global(svg) {
    width: 22px;
    height: 22px;
  }
  .lb-prev {
    grid-column: 1;
    grid-row: 1;
  }
  .lb-next {
    grid-column: 3;
    grid-row: 1;
  }
  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
    margin: 0;
  }
  .lb-close :global(svg) {
    transform: rotate(45deg);
  }
  @media (max-width: 700px) {
    .lightbox[open] {
      grid-template-columns: 1fr;
    }
    .lb-figure {
      grid-column: 1;
      padding: 72px 12px 96px;
    }
    .lb-prev,
    .lb-next {
      position: absolute;
      bottom: 24px;
      grid-column: auto;
    }
    .lb-prev {
      left: calc(50% - 64px);
    }
    .lb-next {
      right: calc(50% - 64px);
    }
  }
  .gallery--1 :global(.gallery-media) {
    aspect-ratio: 21 / 9;
  }
  @media (max-width: 700px) {
    .gallery--1 :global(.gallery-media) {
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 700px) {
    .gallery--2,
    .gallery--3 {
      grid-template-columns: 1fr;
    }
  }

  .related {
    display: grid;
    gap: clamp(14px, 1.6vw, 24px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 900px) {
    .related {
      grid-template-columns: 1fr;
    }
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--green-900);
    transition: color 0.3s;
  }
  .pager-link span {
    display: grid;
  }
  .pager-link small {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-600);
  }
  .pager-link--next {
    text-align: right;
  }
  .pager-link :global(svg) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--gold-600);
  }
  .pager-link:hover {
    color: var(--gold-600);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const items: Array<{ src: string; alt: string; credit: string }> = JSON.parse(
      dialog.querySelector('[data-lb-data]')!.textContent || '[]',
    );
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const render = () => {
      const it = items[index];
      img.src = it.src;
      img.alt = it.alt;
      // restart the fade-in animation
      img.style.animation = 'none';
      void img.offsetWidth;
      img.style.animation = '';
      caption.textContent = it.credit ? `${it.alt} · ${it.credit}` : it.alt;
      count.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
    };
    const go = (i: number) => {
      index = (i + items.length) % items.length;
      render();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-lb-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        go(Number(btn.dataset.lbOpen));
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => go(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => go(index + 1));
    // click on the dark area (not on the photo or buttons) closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lb-figure')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });
    // swipe on touch screens
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) go(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
