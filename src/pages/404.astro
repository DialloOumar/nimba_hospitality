---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<Base title="Page introuvable" noindex>
  <section class="nf on-dark">
    <Photo k="nimba-clouds" alt="Monts Nimba dans la brume" eager class="nf-media" />
    <div class="nf-shade" aria-hidden="true"></div>
    <div class="container nf-inner">
      <span class="eyebrow">Erreur 404</span>
      <h1 class="h1">Ce chemin se perd <em>dans la brume.</em></h1>
      <p>La page que vous cherchez n'existe pas ou a été déplacée.</p>
      <div class="nf-actions">
        <a href={url('/')} class="btn">Retour à l'accueil <Icon name="arrow" /></a>
        <a href={url('/destinations')} class="btn btn--ghost">Explorer la Guinée</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--green-950);
  }
  .nf :global(.nf-media) {
    position: absolute;
    inset: 0;
  }
  .nf-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 31, 20, 0.88), rgba(7, 31, 20, 0.4));
  }
  .nf-inner {
    position: relative;
    padding-top: var(--header-h);
  }
  .nf h1 {
    max-width: 13ch;
  }
  .nf p {
    margin: 24px 0 36px;
    font-size: 1.05rem;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
